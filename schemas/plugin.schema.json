{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yyn0210/luban-notepad-store/schemas/plugin.schema.json",
  "title": "Luban Notepad plugin entry",
  "description": "One plugin published in the Luban Notepad plugin store.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "publisher", "latest_version", "versions"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional schema hint for editors."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "$ref": "#/$defs/httpsUrl"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "source": {
      "$ref": "#/$defs/httpsUrl"
    },
    "homepage": {
      "$ref": "#/$defs/httpsUrl"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "latest_version": {
      "$ref": "#/$defs/semver"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/version"
      }
    },
    "localizations": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 35
      },
      "additionalProperties": {
        "$ref": "#/$defs/localization"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^/@\\s]+[^#\\s]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "target": {
      "type": "string",
      "enum": [
        "universal",
        "linux-x64",
        "linux-arm64",
        "darwin-x64",
        "darwin-arm64",
        "windows-x64",
        "windows-arm64"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "url", "sha256", "size"],
      "properties": {
        "target": {
          "$ref": "#/$defs/target"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifacts"],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "api_version": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "released_at": {
          "type": "string"
        },
        "release_notes": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
